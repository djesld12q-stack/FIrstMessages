    private bool IsVersionNewer(string remote, string local)
    {
        try
        {
            Version rv, lv;
            string remoteNorm = NormalizeVersionString(remote);
            string localNorm = NormalizeVersionString(local);
            if (Version.TryParse(remoteNorm, out rv) && Version.TryParse(localNorm, out lv))
                return rv > lv;
        }
        catch
        {
        }

        return !string.Equals(remote?.Trim(), local?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private string NormalizeVersionString(string v)
    {
        if (string.IsNullOrWhiteSpace(v))
            return "0.0.0";
        v = v.Trim().TrimStart('v', 'V');
        int dots = v.Count(c => c == '.');
        if (dots == 0)
            v += ".0";
        return v;
    }

