    public bool Execute()
    {
        try
        {
            try
            {
                if (args != null)
                {
                    string allArgs = string.Join(" | ", args.Where(kv => kv.Value != null).Select(kv => $"{kv.Key}={kv.Value}"));
                    if (allArgs.Length > 0)
                        LogToFile($"[ARGS] {allArgs}");
                }
            }
            catch
            {
            }

            if (IsStreamStartEvent())
            {
                LogToFile("[EXECUTE] → Detected STREAM START event");
                OnStreamStarted();
                return true;
            }

            if (IsStreamStopEvent())
            {
                LogToFile("[EXECUTE] → Detected STREAM STOP event");
                OnStreamStopped();
                return true;
            }

            string updateTriggerId = GetArg("triggerId");
            if (updateTriggerId == "UPDATE-CHECK-TRIGGER-ID")
            {
                ThreadPool.QueueUserWorkItem(_ => CheckForUpdate(announceInChat: true));
                return true;
            }

            string syncTriggerId = GetArg("triggerId");
            if (syncTriggerId == "SYNC-FILTERS-TRIGGER-ID")
            {
                ThreadPool.QueueUserWorkItem(_ => SyncAllFilterLists());
                return true;
            }

            string user = GetArg("user") ?? GetArg("userName") ?? GetArg("displayName") ?? GetArg("redeemer") ?? GetArg("targetUser") ?? GetArg("raidUser") ?? GetArg("from_broadcaster_user_name") ?? "друже";
            if (string.IsNullOrWhiteSpace(user))
            {
                LogToFile("[SKIP] Порожнє ім'я");
                return true;
            }

            user = user.Trim();
            string key = user.ToLowerInvariant();
            string source = GetArg("__source") ?? "невідомо";

            // ==== ПОВНИЙ ІГНОР — перевіряється ПЕРШИМ, до будь-якої іншої логіки ====
            // 0 тексту в чат, 0 звуку, 0 гіфки, 0 фото, 0 запису в чергу.
            // Спрацьовує і для ручного списку Hello_excludedBots, і для власника каналу.
            if (IsFullyExcluded(key))
            {
                LogToFile($"[SKIP] {user} | Hello_excludedBots / Broadcaster — повний ігнор (0 тексту, 0 звуку, 0 медіа)");
                return true;
            }

            LogToFile($"[EXECUTE START] {user} | greetedList: '{CPH.GetGlobalVar<string>("Hello_greetedList", true) ?? "null"}'");
            if (streamJustStarted)
            {
                lock (queueLock)
                {
                    if (streamJustStarted)
                    {
                        ClearHelloLists("Execute - streamJustStarted (одноразово)");
                        greetQueue.Clear();
                        isProcessingQueue = false;
                        SavePendingQueue(new List<string>());
                        streamJustStarted = false;
                        LogToFile("[STREAM FLAG] Очищення виконано один раз, прапорець знято");
                    }
                }
            }

            string triggerId = GetArg("triggerId");
            if (triggerId == "729c7c0a-597f-4291-97db-bf756847f819")
            {
                OpenSettingsWindow();
                ThreadPool.QueueUserWorkItem(_ =>
                {
                    ClearHelloLists("GUI Trigger");
                    LogToFile("[GUI] Відкрито налаштування");
                });
                return true;
            }

            bool isReward = !string.IsNullOrEmpty(GetArg("rewardId")) || source.IndexOf("reward", StringComparison.OrdinalIgnoreCase) >= 0 || source.IndexOf("redemption", StringComparison.OrdinalIgnoreCase) >= 0;
            string firstRaw = (GetArg("firstMessage") ?? GetArg("isFirstMessage") ?? GetArg("first_message") ?? "false").Trim().ToLowerInvariant();
            bool isFirstMessage = firstRaw == "true" || firstRaw == "1" || source.IndexOf("first", StringComparison.OrdinalIgnoreCase) >= 0 || source.IndexOf("words", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isRaid = !string.IsNullOrEmpty(GetArg("viewers")) || source.IndexOf("raid", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isTestMode = IsTruthyArg("__test") || IsTruthyArg("isTest") || IsTruthyArg("test");
            bool alreadyGreetedOrQueued;
            lock (queueLock)
            {
                var greetedNow = GetGreetedSet();
                var pendingNow = GetPendingQueue();
                alreadyGreetedOrQueued = greetedNow.Contains(key) || pendingNow.Any(p => p.Equals(key, StringComparison.OrdinalIgnoreCase));
            }

            if (alreadyGreetedOrQueued && !isTestMode)
            {
                LogToFile($"[SKIP] {user} | Вже привітаний або вже в черзі");
                return true;
            }

            string message = (GetArg("message") ?? GetArg("input") ?? GetArg("rawInput") ?? GetArg("rewardInput") ?? "").Trim();
            LogToFile($"[MESSAGE] {user} | message='{message}' | isReward={isReward} | isFirstMessage={isFirstMessage} | isRaid={isRaid} | isTestMode={isTestMode}");
            if (message.Length > 0 && !isTestMode)
            {
                if (ContainsIgnoreWord(message))
                {
                    LogToFile($"[SKIP] {user} | Ігнор-слово");
                    return true;
                }

                if (ContainsIgnoreSymbol(message))
                {
                    LogToFile($"[SKIP] {user} | Ігнор-символ");
                    return true;
                }

                if (ContainsRussianLetter(message))
                {
                    LogToFile($"[SKIP] {user} | Кирилиця");
                    return true;
                }

                if (ContainsBadDomain(message))
                {
                    LogToFile($"[SKIP] {user} | Заборонений домен");
                    return true;
                }
            }

            bool shouldGreet = isReward || isFirstMessage || isRaid || isTestMode;
            if (!shouldGreet)
            {
                LogToFile($"[SKIP] {user} | Не підходить під тип");
                return true;
            }

            LogToFile($"[GREET] {user} | {(isTestMode ? "Тест" : isReward ? "Нагорода" : isFirstMessage ? "Перше повідомлення" : isRaid ? "Рейд" : "Тест")}");
            string viewers = isRaid ? (GetArg("viewers") ?? "багатьох") : null;
            bool onlyMediaMode = IsOnlyMedia(key);
            bool noSoundMode = !onlyMediaMode && IsIgnoredMedia(key);
            bool sendText = !onlyMediaMode;
            string greetingText = sendText ? GetGreetingText(user, viewers, isRaid) : null;
            bool playSound = onlyMediaMode || !noSoundMode;
            string userSoundPath = GetUserSound(key);
            bool hasPersonalSound = !string.IsNullOrEmpty(userSoundPath) && File.Exists(userSoundPath);
            LogToFile($"[USER SOUND] {user} | key='{key}' | персональний знайдено={hasPersonalSound} | path='{(hasPersonalSound ? userSoundPath : "немає — буде дефолтний")}'");
            string profileImageUrl = GetArg("targetUserProfileImageUrl") ?? GetArg("userProfileImageUrl") ?? GetArg("profileImageUrl") ?? GetArg("profile_image_url");
            LogToFile($"[PROFILE URL] {user} | url='{profileImageUrl ?? "null"}'");
            string capturedUser = user;
            bool capturedPlaySound = playSound;
            string capturedProfileUrl = profileImageUrl;
            string capturedKey = key;
            string capturedSoundPath = userSoundPath;
            bool capturedIsTestMode = isTestMode;
            Action mediaAction = () =>
            {
                // Повторна перевірка повного ігнору на етапі виконання черги —
                // якщо список змінили поки юзер стояв у черзі, дія все одно скасовується.
                if (IsFullyExcluded(capturedKey))
                {
                    LogToFile($"[QUEUE SKIP] {capturedUser} | Hello_excludedBots / Broadcaster виявлено на етапі виконання черги — дія скасована (0 тексту, 0 звуку, 0 медіа)");
                    lock (queueLock)
                    {
                        var pendingSkip = GetPendingQueue();
                        pendingSkip.RemoveAll(pq => pq.Equals(capturedKey, StringComparison.OrdinalIgnoreCase));
                        SavePendingQueue(pendingSkip);
                    }

                    return;
                }

                lock (queueLock)
                {
                    var greetedSet = GetGreetedSet();
                    greetedSet.Add(capturedKey);
                    SaveGreetedSet(greetedSet);
                }

                if (sendText && !string.IsNullOrEmpty(greetingText))
                {
                    try
                    {
                        CPH.SendMessage(greetingText, true);
                        LogToFile($"[TEXT] {capturedUser} | Відправлено");
                    }
                    catch (Exception ex)
                    {
                        LogToFile($"[TEXT ERROR] {capturedUser} | {ex.Message}");
                    }
                }

                try
                {
                    PlayMedia(capturedUser, capturedPlaySound, capturedProfileUrl, capturedSoundPath, capturedIsTestMode);
                    LogToFile($"[MEDIA] {capturedUser} | Відтворено");
                }
                catch (Exception ex)
                {
                    LogToFile($"[MEDIA ERROR] {capturedUser} | {ex.Message}");
                }

                int delaySec = capturedIsTestMode ? 0 : GetIntSetting("queueDelaySec");
                if (delaySec > 0)
                    CPH.Wait(delaySec * 1000);
                lock (queueLock)
                {
                    var pending = GetPendingQueue();
                    pending.RemoveAll(p => p.Equals(capturedKey, StringComparison.OrdinalIgnoreCase));
                    SavePendingQueue(pending);
                }

                LogToFile($"[QUEUE DONE] {capturedUser} | Видалено з pendingQueue, привітання завершено");
            };
            lock (queueLock)
            {
                var pending = GetPendingQueue();
                if (!pending.Any(p => p.Equals(key, StringComparison.OrdinalIgnoreCase)))
                {
                    pending.Add(key);
                    greetQueue.Enqueue(mediaAction);
                    SavePendingQueue(pending);
                    LogToFile($"[QUEUE] {user} | Додано у чергу (позиція {pending.Count} з {pending.Count})");
                }
                else if (isTestMode)
                {
                    greetQueue.Enqueue(mediaAction);
                    LogToFile($"[QUEUE] {user} | Тестовий запуск додано в чергу поза pendingQueue-дедублікацією");
                }
                else
                {
                    LogToFile($"[QUEUE] {user} | Вже в pendingQueue — дублікат проігноровано");
                }
            }

            bool shouldStart = false;
            lock (queueLock)
            {
                if (!isProcessingQueue && greetQueue.Count > 0)
                {
                    isProcessingQueue = true;
                    shouldStart = true;
                }
            }

            if (shouldStart)
                ThreadPool.QueueUserWorkItem(_ => ProcessQueue());
            return true;
        }
        catch (Exception ex)
        {
            LogToFile($"[EXECUTE ERROR] {GetArg("user") ?? "?"} | {ex.Message}");
            CPH.LogError($"[HELLO ERROR] {ex.Message}");
            return false;
        }
    }

    private void ProcessQueue()
    {
        while (true)
        {
            Action nextAction = null;
            lock (queueLock)
            {
                if (greetQueue.Count > 0)
                    nextAction = greetQueue.Dequeue();
                else
                {
                    isProcessingQueue = false;
                    break;
                }
            }

            if (nextAction != null)
            {
                try
                {
                    nextAction();
                }
                catch (Exception ex)
                {
                    LogToFile($"[QUEUE ERROR] {ex.Message}");
                    CPH.LogError($"[HELLO QUEUE ERROR] {ex.Message}");
                }
            }
        }

        bool needsRestart = false;
        lock (queueLock)
        {
            if (!isProcessingQueue && greetQueue.Count > 0)
            {
                isProcessingQueue = true;
                needsRestart = true;
            }
        }

        if (needsRestart)
            ProcessQueue();
    }

    private List<string> GetPendingQueue()
    {
        string str = GetSetting("pendingQueue");
        if (string.IsNullOrWhiteSpace(str) || str == ClearedMarker)
            return new List<string>();
        return str.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).Where(s => s.Length > 0).ToList();
    }

    private void SavePendingQueue(List<string> list)
    {
        string str = (list == null || list.Count == 0) ? ClearedMarker : string.Join("|", list);
        CPH.SetGlobalVar("Hello_pendingQueue", str, true);
    }

    private string GetUserSound(string userKey)
    {
        try
        {
            string raw = GetSetting("userSounds");
            if (string.IsNullOrWhiteSpace(raw) || raw == ClearedMarker)
                return null;
            string normalizedKey = (userKey ?? "").Trim().ToLowerInvariant();
            if (string.IsNullOrEmpty(normalizedKey))
                return null;
            var lines = raw.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var line in lines)
            {
                int sep = line.IndexOf('|');
                if (sep <= 0)
                    continue;
                string nick = line.Substring(0, sep).Trim().ToLowerInvariant();
                string path = line.Substring(sep + 1).Trim();
                if (nick == normalizedKey && !string.IsNullOrEmpty(path))
                {
                    if (!File.Exists(path))
                    {
                        LogToFile($"[USER SOUND] {userKey} | Знайдено запис '{nick}', але файл не існує: '{path}' — буде дефолтний звук");
                        return null;
                    }

                    return path;
                }
            }
        }
        catch (Exception ex)
        {
            LogToFile($"[USER SOUND ERROR] {ex.Message}");
        }

        return null;
    }

    private string GetGreetingText(string user, string viewers = null, bool isRaid = false)
    {
        var list = Split(GetSetting("greetings"));
        string text = list.Count == 0 ? (isRaid ? "Ласкаво просимо до рейду від %userName% з %viewers% глядачами! " : "Привіт, %userName%! Ласкаво просимо! ") : PickRandom(list);
        text = text.Replace("%userName%", user);
        if (!string.IsNullOrEmpty(viewers))
            text = text.Replace("%viewers%", viewers).Replace("%count%", viewers);
        return text;
    }

private int GetAudioDurationMs(string path)
{
    try
    {
        if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
            return 0;

        var player = new System.Windows.Media.MediaPlayer();
        {
            var tcs = new System.Threading.ManualResetEventSlim(false);
            int durationMs = 0;

            player.MediaOpened += (s, e) =>
            {
                if (player.NaturalDuration.HasTimeSpan)
                    durationMs = (int)player.NaturalDuration.TimeSpan.TotalMilliseconds;
                tcs.Set();
            };
            player.MediaFailed += (s, e) => tcs.Set();

            player.Open(new Uri(path, UriKind.Absolute));
            tcs.Wait(TimeSpan.FromSeconds(3));
            player.Close();

            return durationMs;
        }
    }
    catch (Exception ex)
    {
        LogToFile($"[AUDIO DURATION ERROR] {path} | {ex.Message}");
        return 0;
    }
}

   private void PlayMedia(string userName, bool playSound = true, string profileImageUrl = null, string userSoundOverride = null, bool isTestMode = false)
{
    var gifs = Split(GetSetting("gifUrls"));

    bool usingPersonalSound = !string.IsNullOrEmpty(userSoundOverride) && File.Exists(userSoundOverride);
    string soundPath = usingPersonalSound
        ? userSoundOverride
        : GetSetting("soundPath");
    string soundLogLabel = usingPersonalSound
        ? "ПЕРСОНАЛЬНИЙ"
        : (isTestMode ? "ТЕСТ — персональний не знайдено, грає дефолтний" : "дефолтний");
    LogToFile($"[PLAY MEDIA] {userName} | звук: {soundLogLabel} | path='{soundPath}'");

    int gifDuration = GetIntSetting("gifDuration");
    int soundDelay = GetIntSetting("soundDelayMs");
    int profileDuration = GetIntSetting("profileDuration");
    string scene = GetSetting("obsScene");
    string gifSource = GetSetting("obsSource");
    string profileSource = GetSetting("obsSourceProfile");
    string textSource = GetSetting("obsTextSource");
    string textTemplate = GetSetting("textTemplate");
    float volume = GetFloatSetting("soundVolume");
    bool hasGif = gifs.Count > 0 && !string.IsNullOrWhiteSpace(scene) && !string.IsNullOrWhiteSpace(gifSource) && gifDuration > 0;
    bool hasProfile = !string.IsNullOrWhiteSpace(profileImageUrl) && !string.IsNullOrWhiteSpace(scene) && !string.IsNullOrWhiteSpace(profileSource);
    bool hasText = !string.IsNullOrWhiteSpace(scene) && !string.IsNullOrWhiteSpace(textSource) && !string.IsNullOrWhiteSpace(textTemplate) && !string.IsNullOrWhiteSpace(userName);
    bool hasSound = playSound && !string.IsNullOrEmpty(soundPath) && File.Exists(soundPath);

    int soundDurationMs = hasSound ? GetAudioDurationMs(soundPath) : 0;

    int animDuration = gifDuration;
    if (!hasGif && (hasProfile || hasText))
        animDuration = profileDuration > 0 ? profileDuration : 5000;
    else if (hasProfile && profileDuration > 0)
        animDuration = Math.Max(gifDuration, profileDuration);

    int totalWaitAfterDelay = Math.Max(animDuration, soundDurationMs);

    if (hasProfile)
    {
        CPH.ObsSetBrowserSource(scene, profileSource, profileImageUrl);
        CPH.ObsShowSource(scene, profileSource);
    }

    if (hasGif)
    {
        string gif = PickRandom(gifs);
        CPH.ObsSetBrowserSource(scene, gifSource, gif);
        CPH.ObsShowSource(scene, gifSource);
    }

    if (hasText)
    {
        string finalText = textTemplate.Replace("%userName%", userName);
        CPH.ObsSetGdiText(scene, textSource, finalText);
        CPH.ObsShowSource(scene, textSource);
    }

    if (hasGif || hasProfile || hasText || hasSound)
    {
        if (soundDelay > 0)
            CPH.Wait(soundDelay);
        if (hasSound)
            CPH.PlaySound(soundPath, volume);
        int remaining = totalWaitAfterDelay - Math.Max(0, soundDelay);
        if (remaining > 0)
            CPH.Wait(remaining);
    }
    else if (hasSound)
    {
        CPH.Wait(Math.Max(soundDurationMs, 0));
    }

    if (hasGif)
        CPH.ObsHideSource(scene, gifSource);
    if (hasProfile)
        CPH.ObsHideSource(scene, profileSource);
    if (hasText)
        CPH.ObsHideSource(scene, textSource);
}

    private HashSet<string> GetGreetedSet()
    {
        string str = GetSetting("greetedList");
        if (string.IsNullOrWhiteSpace(str) || str == ClearedMarker)
            return new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var part in str.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var t = part.Trim().ToLowerInvariant();
            if (!string.IsNullOrEmpty(t))
                set.Add(t);
        }

        return set;
    }

    private void SaveGreetedSet(HashSet<string> set)
    {
        string str = (set == null || set.Count == 0) ? ClearedMarker : string.Join("|", set);
        CPH.SetGlobalVar("Hello_greetedList", str, true);
    }

    private HashSet<string> GetIgnoreSet(string k)
    {
        var list = Split(GetSetting(k));
        return new HashSet<string>(list.Select(s => s.Trim().ToLowerInvariant()).Where(s => !string.IsNullOrEmpty(s)), StringComparer.OrdinalIgnoreCase);
    }

    private bool IsOnlyMedia(string key) => GetIgnoreSet("onlyMediaUsers").Contains(key);
    private bool IsIgnoredMedia(string key) => GetIgnoreSet("ignoreMediaUsers").Contains(key);
    private string GetArg(string k) => args != null && args.ContainsKey(k) && args[k] != null ? args[k].ToString().Trim() : null;
    private bool IsTruthyArg(string argName)
    {
        string v = (GetArg(argName) ?? "").Trim().ToLowerInvariant();
        return v == "true" || v == "1" || v == "yes";
    }

    private string GetSetting(string key)
    {
        try
        {
            var val = CPH.GetGlobalVar<string>("Hello_" + key, true);
            if (string.IsNullOrWhiteSpace(val))
                return key == "textTemplate" ? "%userName%" : "";
            return val.Trim();
        }
        catch
        {
            return key == "textTemplate" ? "%userName%" : "";
        }
    }

    private int GetIntSetting(string key)
    {
        string s = GetSetting(key);
        return int.TryParse(s, out int v) ? v : 0;
    }

    private float GetFloatSetting(string key)
    {
        string s = GetSetting(key);
        if (float.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out float v))
        {
            if (v > 1f)
                v = v / 100f;
            return v < 0f ? 0f : (v > 1f ? 1f : v);
        }

        return 0f;
    }

    private List<string> Split(string s) => string.IsNullOrWhiteSpace(s) ? new List<string>() : s.Split(new[] { '|', '\\' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToList();
    private string PickRandom(List<string> l) => l.Count > 0 ? l[rnd.Next(l.Count)] : "";
    private bool ContainsIgnoreWord(string t) => Split(GetSetting("ignoreWords")).Any(w => t.IndexOf(w, StringComparison.OrdinalIgnoreCase) >= 0);
    private bool ContainsIgnoreSymbol(string t) => Split(GetSetting("ignoreSymbols")).Any(s => t.Contains(s));
    private bool ContainsRussianLetter(string t)
    {
        string letters = GetSetting("russianLetters");
        return !string.IsNullOrEmpty(t) && !string.IsNullOrEmpty(letters) && letters.Any(c => t.Contains(c));
    }

    private bool ContainsBadDomain(string t)
    {
        var bad = Split(GetSetting("ignoreDomains"));
        var good = Split(GetSetting("allowedDomains"));
        if (bad.Count == 0 || string.IsNullOrWhiteSpace(t))
            return false;
        var matches = UrlRegex.Matches(t);
        foreach (Match m in matches)
        {
            string h = ExtractHost(m.Value);
            if (string.IsNullOrEmpty(h))
                continue;
            if (good.Any(d => h.Equals(d.TrimStart('.'), StringComparison.OrdinalIgnoreCase) || h.EndsWith("." + d.TrimStart('.'), StringComparison.OrdinalIgnoreCase)))
                continue;
            if (bad.Any(d => h.Equals(d.TrimStart('.'), StringComparison.OrdinalIgnoreCase) || h.EndsWith("." + d.TrimStart('.'), StringComparison.OrdinalIgnoreCase)))
                return true;
        }

        return false;
    }

    private string ExtractHost(string url)
    {
        try
        {
            if (!url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                url = "http://" + url;
            var uri = new Uri(url);
            string host = uri.Host;
            if (host.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
                host = host.Substring(4);
            return host.ToLowerInvariant();
        }
        catch
        {
            return null;
        }
    }

