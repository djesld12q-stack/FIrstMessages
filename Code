    private void BuildUserSoundsManager(StackPanel p)
    {
        AddSectionTitle(p, "🎵", "Персональні звуки", "Окремий звук для конкретного глядача");

        // ── Зчитування / збереження записів ──
        List<(string nick, string path)> GetEntries()
        {
            string raw = "";
            try { raw = CPH.GetGlobalVar<string>("Hello_userSounds", true) ?? ""; } catch { }
            var result = new List<(string, string)>();
            foreach (var line in raw.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
            {
                int sep = line.IndexOf('|');
                if (sep > 0)
                    result.Add((line.Substring(0, sep).Trim(), line.Substring(sep + 1).Trim()));
            }
            return result;
        }

        void SaveEntries(List<(string nick, string path)> entries)
        {
            string raw = entries.Count == 0
                ? ""
                : string.Join("\n", entries.Select(e => $"{e.nick}|{e.path}"));
            CPH.SetGlobalVar("Hello_userSounds", raw, true);
        }

        // ── ListBox ──
        var listBorder = new Border
        {
            CornerRadius    = new CornerRadius(8),
            BorderBrush     = new SolidColorBrush(BorderNormal),
            BorderThickness = new Thickness(2),
            Background      = new SolidColorBrush(BgInput),
            Margin          = new Thickness(0, 0, 0, 10),
            Height          = 180
        };
        var listBox = new ListBox
        {
            Background          = Brushes.Transparent,
            BorderThickness     = new Thickness(0),
            Foreground          = new SolidColorBrush(TextPrimary),
            FontSize            = 12,
            FontFamily          = new FontFamily("Consolas"),
            HorizontalAlignment = HorizontalAlignment.Stretch
        };
        listBorder.Child = listBox;

        void RefreshList()
        {
            listBox.Items.Clear();
            foreach (var (nick, path) in GetEntries())
                listBox.Items.Add($"{nick}  →  {path}");
        }
        RefreshList();
        p.Children.Add(listBorder);

        // ── Форма додавання ──
        var addCard = new Border
        {
            Background      = new SolidColorBrush(Color.FromArgb(30, 150, 70, 255)),
            BorderBrush     = new SolidColorBrush(BorderNormal),
            BorderThickness = new Thickness(2),
            CornerRadius    = new CornerRadius(8),
            Padding         = new Thickness(14, 12, 14, 12),
            Margin          = new Thickness(0, 0, 0, 6)
        };

        var addGrid = new Grid();
        addGrid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(150) });
        addGrid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
        addGrid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
        addGrid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
        addGrid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
        addGrid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });

        // Лейбли
        var lblNick = new TextBlock
        {
            Text       = "НІКНЕЙМ",
            FontSize   = 10, FontWeight = FontWeights.Bold,
            Foreground = new SolidColorBrush(TextMuted),
            Margin     = new Thickness(0, 0, 8, 4)
        };
        var lblPath = new TextBlock
        {
            Text       = "ШЛЯХ ДО ЗВУКУ",
            FontSize   = 10, FontWeight = FontWeights.Bold,
            Foreground = new SolidColorBrush(TextMuted),
            Margin     = new Thickness(8, 0, 8, 4)
        };
        Grid.SetRow(lblNick, 0); Grid.SetColumn(lblNick, 0);
        Grid.SetRow(lblPath, 0); Grid.SetColumn(lblPath, 1); Grid.SetColumnSpan(lblPath, 2);
        addGrid.Children.Add(lblNick);
        addGrid.Children.Add(lblPath);

        // Хелпер: поле з placeholder
        TextBox MakeInput(string placeholder)
        {
            var tb = new TextBox
            {
                Height           = 36,
                Padding          = new Thickness(10, 0, 10, 0),
                Background       = new SolidColorBrush(BgInput),
                Foreground       = Brushes.Gray,
                CaretBrush       = new SolidColorBrush(AccentBlue),
                BorderThickness  = new Thickness(2),
                BorderBrush      = new SolidColorBrush(BorderNormal),
                FontSize         = 12,
                FontFamily       = new FontFamily("Consolas"),
                VerticalContentAlignment = VerticalAlignment.Center,
                Tag              = placeholder,
                Text             = placeholder
            };
            tb.GotFocus  += (s, e) =>
            {
                tb.BorderBrush = new SolidColorBrush(BorderFocus);
                if (tb.Text == (string)tb.Tag)
                {
                    tb.Text       = "";
                    tb.Foreground = new SolidColorBrush(TextPrimary);
                }
            };
            tb.LostFocus += (s, e) =>
            {
                tb.BorderBrush = new SolidColorBrush(BorderNormal);
                if (string.IsNullOrWhiteSpace(tb.Text))
                {
                    tb.Text       = (string)tb.Tag;
                    tb.Foreground = Brushes.Gray;
                }
            };
            return tb;
        }

        var nickBox = MakeInput("username");
        var pathBox = MakeInput(@"C:\sounds\user.mp3");
        nickBox.Margin = new Thickness(0, 0, 8, 0);
        pathBox.Margin = new Thickness(0, 0, 6, 0);

        Grid.SetRow(nickBox, 1); Grid.SetColumn(nickBox, 0);
        Grid.SetRow(pathBox, 1); Grid.SetColumn(pathBox, 1);
        addGrid.Children.Add(nickBox);
        addGrid.Children.Add(pathBox);

        // Кнопка Browse
        var browseBtn = MakeActionBtn("📂", AccentBlue);
        browseBtn.Width   = 40;
        browseBtn.Height  = 36;
        browseBtn.Margin  = new Thickness(0, 0, 6, 0);
        browseBtn.ToolTip = "Вибрати звуковий файл";
        browseBtn.Click  += (s, e) =>
        {
            try
            {
                var dlg = new Microsoft.Win32.OpenFileDialog
                {
                    Title  = "Вибір звукового файлу",
                    Filter = "Аудіо файли (*.mp3;*.wav;*.ogg)|*.mp3;*.wav;*.ogg|Всі файли (*.*)|*.*"
                };
                if (dlg.ShowDialog() == true)
                {
                    pathBox.Text      = dlg.FileName;
                    pathBox.Foreground = new SolidColorBrush(TextPrimary);
                }
            }
            catch (Exception ex) { CPH.LogWarn($"[BROWSE] {ex.Message}"); }
        };
        Grid.SetRow(browseBtn, 1); Grid.SetColumn(browseBtn, 2);
        addGrid.Children.Add(browseBtn);

        // Кнопка Додати
        var addBtn = MakeActionBtn("＋  Додати", AccentGreen);
        addBtn.Height = 36;
        addBtn.Margin = new Thickness(0);
        addBtn.Click += (s, e) =>
        {
            try
            {
                string nick = nickBox.Text?.Trim() ?? "";
                string path = pathBox.Text?.Trim() ?? "";

                bool nickIsPlaceholder = nick == "username" || string.IsNullOrEmpty(nick);
                bool pathIsPlaceholder = path == @"C:\sounds\user.mp3" || string.IsNullOrEmpty(path);

                if (nickIsPlaceholder || pathIsPlaceholder) return;

                var entries = GetEntries();
                entries.RemoveAll(x => x.nick.Equals(nick, StringComparison.OrdinalIgnoreCase));
                entries.Add((nick.ToLowerInvariant(), path));
                SaveEntries(entries);
                RefreshList();
                LogToFile($"[USER SOUND] Додано: {nick} → {path}");

                nickBox.Text      = "username";          nickBox.Foreground = Brushes.Gray;
                pathBox.Text      = @"C:\sounds\user.mp3"; pathBox.Foreground = Brushes.Gray;
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] Add user sound error: {ex.Message}");
                LogToFile($"[USER SOUND ADD ERROR] {ex.Message}");
            }
        };
        Grid.SetRow(addBtn, 1); Grid.SetColumn(addBtn, 3);
        addGrid.Children.Add(addBtn);

        addCard.Child = addGrid;
        p.Children.Add(addCard);

        // ── Кнопки керування ──
        var ctrlRow   = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 0, 0, 16) };
        var removeBtn = MakeActionBtn("🗑  Видалити", AccentRed);
        removeBtn.Click += (s, e) =>
        {
            try
            {
                if (listBox.SelectedItem == null) return;
                string sel  = listBox.SelectedItem.ToString();
                string nick = sel.Contains("→")
                    ? sel.Split(new[] { "  →  " }, StringSplitOptions.None)[0].Trim()
                    : "";
                if (string.IsNullOrEmpty(nick)) return;
                var entries = GetEntries();
                entries.RemoveAll(x => x.nick.Equals(nick, StringComparison.OrdinalIgnoreCase));
                SaveEntries(entries);
                RefreshList();
                LogToFile($"[USER SOUND] Видалено: {nick}");
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] Remove user sound error: {ex.Message}");
                LogToFile($"[USER SOUND REMOVE ERROR] {ex.Message}");
            }
        };
        ctrlRow.Children.Add(removeBtn);
        p.Children.Add(ctrlRow);

        AddHintBox(p,
            "① Введи нікнейм  ② Натисни 📂 щоб вибрати файл через провідник  ③ Натисни ＋ Додати\n" +
            "Регістр не важливий. Якщо нікнейм вже є у списку — шлях замінюється.\n" +
            "Якщо глядача немає у списку — грає дефолтний звук.");
    }

