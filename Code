    private void SaveTextBoxesInGrid(DependencyObject parent)
    {
        if (parent == null) return;
        int n = VisualTreeHelper.GetChildrenCount(parent);
        for (int i = 0; i < n; i++)
        {
            var child = VisualTreeHelper.GetChild(parent, i);
            if (child is TextBox tb && tb.Tag is string tag && !string.IsNullOrEmpty(tag))
            {
                // Пропускаємо placeholder-значення (tag == text означає порожнє поле)
                string val = tb.Text?.Trim() ?? "";
                if (val == tag) val = "";
                CPH.SetGlobalVar(tag, val, true);
            }
            else
            {
                SaveTextBoxesInGrid(child);
            }
        }
    }
