    private UIElement MakeField(string tag, int height = 44, bool multiline = false)
    {
        string val = "";
        try { val = CPH.GetGlobalVar<string>(tag, true) ?? ""; } catch { }

        var tb = new TextBox
        {
            Tag       = tag, Text = val, MinHeight = height,
            Padding   = new Thickness(12, 9, 12, 9),
            Background = Brushes.Transparent,
            Foreground = new SolidColorBrush(TextPrimary),
            CaretBrush = new SolidColorBrush(AccentBlue),
            BorderThickness  = new Thickness(0),
            FontSize         = 13, FontFamily = new FontFamily("Consolas"),
            TextWrapping     = multiline ? TextWrapping.Wrap : TextWrapping.NoWrap,
            AcceptsReturn    = multiline,
            VerticalScrollBarVisibility   = multiline ? ScrollBarVisibility.Auto : ScrollBarVisibility.Disabled,
            HorizontalScrollBarVisibility = ScrollBarVisibility.Disabled,
            HorizontalAlignment      = HorizontalAlignment.Stretch,
            VerticalContentAlignment = VerticalAlignment.Top
        };

        var border = new Border
        {
            Child           = tb,
            CornerRadius    = new CornerRadius(8),
            Background      = new SolidColorBrush(BgInput),
            BorderBrush     = new SolidColorBrush(BorderNormal),
            BorderThickness = new Thickness(2),
            Margin          = new Thickness(0, 0, 0, 16),
            HorizontalAlignment = HorizontalAlignment.Stretch
        };

        tb.GotFocus  += (s, e) => border.BorderBrush = new SolidColorBrush(BorderFocus);
        tb.LostFocus += (s, e) =>
        {
            border.BorderBrush = new SolidColorBrush(BorderNormal);
            try
            {
                if (tb.Tag is string t && !string.IsNullOrEmpty(t))
                    CPH.SetGlobalVar(t, tb.Text?.Trim() ?? "", true);
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] LostFocus save error ({tb.Tag}): {ex.Message}");
            }
        };
        return border;
    }

    private void AddLF(StackPanel p, string label, string tag, bool multiline = false, int height = 44, string hint = "")
    {
        AddFieldLabel(p, label.ToUpperInvariant());
        p.Children.Add(MakeField(tag, height, multiline));
        if (!string.IsNullOrEmpty(hint)) AddHintBox(p, hint);
    }

    private void AddVolumeSlider(StackPanel p)
    {
        AddFieldLabel(p, "ГУЧНІСТЬ ЗВУКУ");

        string rawVal = "";
        try { rawVal = CPH.GetGlobalVar<string>("Hello_soundVolume", true) ?? ""; } catch { }

        int initialPercent = 75;
        if (float.TryParse(rawVal, NumberStyles.Any, CultureInfo.InvariantCulture, out float fv))
            initialPercent = fv > 1f ? (int)Math.Round(fv) : (int)Math.Round(fv * 100f);

        var sliderCard = new Border
        {
            Background      = new SolidColorBrush(BgInput),
            BorderBrush     = new SolidColorBrush(BorderNormal),
            BorderThickness = new Thickness(2),
            CornerRadius    = new CornerRadius(8),
            Padding         = new Thickness(16, 12, 16, 12),
            Margin          = new Thickness(0, 0, 0, 16)
        };

        var sliderInner = new StackPanel();

        var topRow = new Grid();
        topRow.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
        topRow.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
        topRow.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });

        var iconLeft  = new TextBlock { Text = "🔈", FontSize = 16, VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(0, 0, 8, 0) };
        var iconRight = new TextBlock { Text = "🔊", FontSize = 16, VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(8, 0, 0, 0) };

        var valueDisplay = new Border
        {
            Background      = new SolidColorBrush(Color.FromArgb(60, 0, 0, 0)),
            BorderBrush     = new SolidColorBrush(Color.FromArgb(80, 150, 70, 255)),
            BorderThickness = new Thickness(1),
            CornerRadius    = new CornerRadius(6),
            Padding         = new Thickness(10, 4, 10, 4),
            HorizontalAlignment = HorizontalAlignment.Right,
            Margin = new Thickness(0, 0, 0, 8)
        };
        var valueLabel = new TextBlock
        {
            Text          = $"{initialPercent}%",
            FontSize      = 16, FontWeight = FontWeights.Bold,
            FontFamily    = new FontFamily("Consolas"),
            Foreground    = new SolidColorBrush(Color.FromRgb(200, 240, 160)),
            MinWidth      = 50,
            TextAlignment = TextAlignment.Center
        };
        valueDisplay.Child = valueLabel;

        var slider = new Slider
        {
            Minimum = 0, Maximum = 100,
            Value   = initialPercent,
            TickFrequency       = 5,
            IsSnapToTickEnabled = true,
            SmallChange = 1, LargeChange = 10,
            HorizontalAlignment = HorizontalAlignment.Stretch,
            Margin = new Thickness(0, 6, 0, 0)
        };

        slider.ValueChanged += (s, e) =>
        {
            int   pct      = (int)slider.Value;
            float floatVal = pct / 100f;
            valueLabel.Text = $"{pct}%";
            try
            {
                CPH.SetGlobalVar("Hello_soundVolume", floatVal.ToString("F2", CultureInfo.InvariantCulture), true);
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] Volume save error: {ex.Message}");
            }

            valueLabel.Foreground = pct == 0
                ? new SolidColorBrush(Color.FromRgb(180, 100, 100))
                : pct < 30
                    ? new SolidColorBrush(Color.FromRgb(240, 200, 100))
                    : new SolidColorBrush(Color.FromRgb(130, 230, 120));
        };

        Grid.SetColumn(iconLeft,  0);
        Grid.SetColumn(slider,    1);
        Grid.SetColumn(iconRight, 2);
        topRow.Children.Add(iconLeft);
        topRow.Children.Add(slider);
        topRow.Children.Add(iconRight);

        sliderInner.Children.Add(valueDisplay);
        sliderInner.Children.Add(topRow);

        var labelsRow = new Grid { Margin = new Thickness(0, 4, 0, 0) };
        labelsRow.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
        labelsRow.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
        labelsRow.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
        labelsRow.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
        labelsRow.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });

        void AddTickLabel(string ltext, int col)
        {
            var lbl = new TextBlock
            {
                Text       = ltext, FontSize = 10,
                Foreground = new SolidColorBrush(TextMuted),
                HorizontalAlignment = col == 0 ? HorizontalAlignment.Left
                                    : col == 4 ? HorizontalAlignment.Right
                                    :            HorizontalAlignment.Center
            };
            Grid.SetColumn(lbl, col);
            labelsRow.Children.Add(lbl);
        }
        AddTickLabel("0%",   0);
        AddTickLabel("50%",  2);
        AddTickLabel("100%", 4);
        sliderInner.Children.Add(labelsRow);

        sliderCard.Child = sliderInner;
        p.Children.Add(sliderCard);

        slider.Value = initialPercent;
    }

