    private UIElement BuildQueueContent()
    {
        var queueScroll = new Style(typeof(ScrollViewer));
        queueScroll.Setters.Add(new Setter(ScrollViewer.HorizontalScrollBarVisibilityProperty, ScrollBarVisibility.Disabled));
        queueScroll.Setters.Add(new Setter(ScrollViewer.VerticalScrollBarVisibilityProperty,   ScrollBarVisibility.Hidden));
        queueScroll.Setters.Add(new Setter(ScrollViewer.PanningModeProperty,                   PanningMode.VerticalOnly));

        var outer = new StackPanel { Margin = new Thickness(28, 20, 28, 28) };

        var titleRow = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 0, 0, 6) };
        titleRow.Children.Add(new TextBlock { Text = "📋", FontSize = 18, Margin = new Thickness(0, 0, 8, 0), VerticalAlignment = VerticalAlignment.Center });
        titleRow.Children.Add(new TextBlock { Text = "Черга привітань", FontSize = 16, FontWeight = FontWeights.Bold, Foreground = new LinearGradientBrush(AccentPurple, AccentBlue, 0), VerticalAlignment = VerticalAlignment.Center });
        outer.Children.Add(titleRow);
        outer.Children.Add(new Border { Height = 1, Margin = new Thickness(0, 4, 0, 16), Background = new LinearGradientBrush(Color.FromArgb(90, 150, 70, 255), Color.FromArgb(0, 150, 70, 255), 0) });

        var countText = new TextBlock { Text = "У черзі: 0", FontSize = 12, Foreground = new SolidColorBrush(TextMuted), Margin = new Thickness(0, 0, 0, 8) };
        outer.Children.Add(countText);

        var listBorder = new Border
        {
            CornerRadius    = new CornerRadius(8),
            BorderBrush     = new SolidColorBrush(BorderNormal),
            BorderThickness = new Thickness(2),
            Background      = new SolidColorBrush(BgInput),
            Margin          = new Thickness(0, 0, 0, 14),
            Height          = 280
        };
        var listBox = new ListBox
        {
            Background      = Brushes.Transparent,
            BorderThickness = new Thickness(0),
            Foreground      = new SolidColorBrush(TextPrimary),
            FontSize        = 13,
            HorizontalAlignment = HorizontalAlignment.Stretch
        };
        listBorder.Child = listBox;
        outer.Children.Add(listBorder);

        void RefreshList()
        {
            try
            {
                listBox.Items.Clear();
                var pending = GetPendingQueue();
                foreach (var item in pending) listBox.Items.Add(item);
                countText.Text = $"У черзі: {pending.Count}";
            }
            catch (Exception ex)
            {
                countText.Text = "Помилка читання черги";
                CPH.LogWarn($"[HELLO QUEUE GUI] {ex.Message}");
            }
        }
        RefreshList();

        var btnRow     = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 0, 0, 0) };
        var removeBtn  = MakeActionBtn("🗑  Видалити", AccentRed);
        var clearBtn   = MakeActionBtn("✕  Очистити",  Color.FromRgb(200, 50, 70));
        var upBtn      = MakeActionBtn("↑  Вгору",     AccentBlue);
        var downBtn    = MakeActionBtn("↓  Вниз",      AccentBlue);
        var refreshBtn = MakeActionBtn("↻  Оновити",   AccentPurple);

        removeBtn.Click += (s, e) =>
        {
            try
            {
                if (listBox.SelectedItem == null) return;
                string sel  = listBox.SelectedItem.ToString();
                var pending = GetPendingQueue();
                pending.RemoveAll(x => x.Equals(sel, StringComparison.OrdinalIgnoreCase));
                SavePendingQueue(pending);
                RefreshList();
                LogToFile($"[QUEUE GUI] Видалено: {sel}");
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] Queue remove error: {ex.Message}");
                LogToFile($"[QUEUE GUI REMOVE ERROR] {ex.Message}");
            }
        };

        clearBtn.Click += (s, e) =>
        {
            try
            {
                SavePendingQueue(new List<string>());
                listBox.Items.Clear();
                countText.Text = "У черзі: 0";
                LogToFile("[QUEUE GUI] Черга очищена");
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] Queue clear error: {ex.Message}");
                LogToFile($"[QUEUE GUI CLEAR ERROR] {ex.Message}");
            }
        };

        upBtn.Click += (s, e) =>
        {
            try
            {
                if (listBox.SelectedItem == null) return;
                int idx     = listBox.SelectedIndex;
                if (idx <= 0) return;
                var pending = GetPendingQueue();
                if (idx >= pending.Count) return;
                var item = pending[idx];
                pending.RemoveAt(idx);
                pending.Insert(idx - 1, item);
                SavePendingQueue(pending);
                RefreshList();
                listBox.SelectedIndex = idx - 1;
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] Queue move-up error: {ex.Message}");
                LogToFile($"[QUEUE GUI UP ERROR] {ex.Message}");
            }
        };

        downBtn.Click += (s, e) =>
        {
            try
            {
                if (listBox.SelectedItem == null) return;
                int idx     = listBox.SelectedIndex;
                var pending = GetPendingQueue();
                if (idx < 0 || idx >= pending.Count - 1) return;
                var item = pending[idx];
                pending.RemoveAt(idx);
                pending.Insert(idx + 1, item);
                SavePendingQueue(pending);
                RefreshList();
                listBox.SelectedIndex = idx + 1;
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] Queue move-down error: {ex.Message}");
                LogToFile($"[QUEUE GUI DOWN ERROR] {ex.Message}");
            }
        };

        refreshBtn.Click += (s, e) => RefreshList();

        btnRow.Children.Add(removeBtn);
        btnRow.Children.Add(clearBtn);
        btnRow.Children.Add(upBtn);
        btnRow.Children.Add(downBtn);
        btnRow.Children.Add(refreshBtn);
        outer.Children.Add(btnRow);

        return new ScrollViewer { Content = outer, Style = queueScroll };
    }

