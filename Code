    private bool IsStreamStartEvent()
    {
        string[] keys = { "eventType", "__source", "triggerName", "eventSource", "__trigger", "type" };
        foreach (var k in keys)
        {
            string v = (GetArg(k) ?? "").ToLowerInvariant();
            if (string.IsNullOrEmpty(v)) continue;

            bool hasStream = v.Contains("stream") || v.Contains("obs");
            bool hasStart  = v.Contains("start") || v.Contains("began") || v.Contains("begin") || v.Contains("launch");

            if (hasStream && hasStart) return true;

            if (v == "streamstarted" || v == "obs_stream_started" || v == "obsstreaming_started") return true;
        }

        string explicit_ = (GetArg("helloEvent") ?? "").ToLowerInvariant();
        if (explicit_ == "streamstarted" || explicit_ == "start") return true;

        return false;
    }

    private bool IsStreamStopEvent()
    {
        string[] keys = { "eventType", "__source", "triggerName", "eventSource", "__trigger", "type" };
        foreach (var k in keys)
        {
            string v = (GetArg(k) ?? "").ToLowerInvariant();
            if (string.IsNullOrEmpty(v)) continue;

            bool hasStream = v.Contains("stream") || v.Contains("obs");
            bool hasStop   = v.Contains("stop")   || v.Contains("end")  || v.Contains("finish")
                          || v.Contains("ended")   || v.Contains("halt");

            if (hasStream && hasStop) return true;

            if (v == "streamstopped" || v == "obs_stream_stopped" || v == "obsstreaming_stopped") return true;
        }

        string explicit_ = (GetArg("helloEvent") ?? "").ToLowerInvariant();
        if (explicit_ == "streamstopped" || explicit_ == "stop") return true;

        return false;
    }

    // =====================================================================
    //  LOGGING
    // =====================================================================

    private void LogToFile(string message)
    {
        try
        {
            string dir = Path.GetDirectoryName(LogFilePath);
            if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
                Directory.CreateDirectory(dir);

            List<string> lines = File.Exists(LogFilePath)
                ? File.ReadAllLines(LogFilePath).ToList()
                : new List<string>();

            DateTime cutoff = DateTime.Now.AddDays(-3);
            lines.RemoveAll(line =>
            {
                if (string.IsNullOrWhiteSpace(line) || line.Length < 19) return true;
                string dateStr = line.Substring(0, 19);
                return !DateTime.TryParseExact(dateStr, "yyyy-MM-dd HH:mm:ss",
                    CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime dt)
                    || dt < cutoff;
            });

            lines.Add($"{DateTime.Now:yyyy-MM-dd HH:mm:ss} | {message}");
            File.WriteAllLines(LogFilePath, lines);
        }
        catch (Exception ex) { CPH.LogError($"[HELLO FILELOG ERROR] {ex.Message}"); }
    }

