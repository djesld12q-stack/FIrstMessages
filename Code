    private void LogToFile(string message)
    {
        try
        {
            string dir = Path.GetDirectoryName(LogFilePath);
            if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
                Directory.CreateDirectory(dir);
            List<string> lines = File.Exists(LogFilePath) ? File.ReadAllLines(LogFilePath).ToList() : new List<string>();
            DateTime cutoff = DateTime.Now.AddDays(-3);
            lines.RemoveAll(line =>
            {
                if (string.IsNullOrWhiteSpace(line) || line.Length < 19)
                    return true;
                string dateStr = line.Substring(0, 19);
                return !DateTime.TryParseExact(dateStr, "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime dt) || dt < cutoff;
            });
            lines.Add($"{DateTime.Now:yyyy-MM-dd HH:mm:ss} | {message}");
            File.WriteAllLines(LogFilePath, lines);
        }
        catch (Exception ex)
        {
            CPH.LogError($"[HELLO FILELOG ERROR] {ex.Message}");
        }
    }

