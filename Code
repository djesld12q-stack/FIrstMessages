    private void ClearHelloLists(string reason)
    {
        try
        {
            string beforeG = CPH.GetGlobalVar<string>("Hello_greetedList",  true) ?? "null";
            string beforeP = CPH.GetGlobalVar<string>("Hello_pendingQueue", true) ?? "null";
            LogToFile($"[CLEAR START] {reason} | greetedList='{beforeG}' | pendingQueue='{beforeP}'");

            CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
            CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
            Thread.Sleep(150);

            string afterG = CPH.GetGlobalVar<string>("Hello_greetedList",  true) ?? "null";
            string afterP = CPH.GetGlobalVar<string>("Hello_pendingQueue", true) ?? "null";
            bool gOK = afterG == ClearedMarker;
            bool pOK = afterP == ClearedMarker;

            if (gOK && pOK)
            {
                LogToFile($"[CLEAR SUCCESS] {reason}");
            }
            else
            {
                LogToFile($"[CLEAR RETRY] {reason} | g={gOK} p={pOK} — повторний запис");
                CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
                CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
                Thread.Sleep(150);

                string fg = CPH.GetGlobalVar<string>("Hello_greetedList",  true) ?? "null";
                string fp = CPH.GetGlobalVar<string>("Hello_pendingQueue", true) ?? "null";
                bool finalOK = fg == ClearedMarker && fp == ClearedMarker;
                LogToFile($"[CLEAR END] {reason} | finalOK={finalOK}");

                if (!finalOK)
                    CPH.LogError($"[HELLO CLEAR ERROR] {reason} | g='{fg}' p='{fp}'");
            }
        }
        catch (Exception ex)
        {
            LogToFile($"[CLEAR ERROR] {reason} | {ex.Message}");
            CPH.LogError($"[HELLO CLEAR ERROR] {ex.Message}");
            try
            {
                CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
                CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
            }
            catch { }
        }
    }

