                CPH.SetGlobalVar(globalVarKey, forcedStr, true);
                LogToFile($"[SYNC {logLabel}] ✅ Примусово перезаписано з GitHub ({remoteItems.Count} записів)");
                CPH.SetGlobalVar($"Hello_filterSync_{logLabel}", "Перезавантажено (force)", true);
                return true;
            }

            string current = "";
            try
            {
                current = CPH.GetGlobalVar<string>(globalVarKey, true) ?? "";
            }
            catch
            {
            }

            var currentItems = (string.IsNullOrWhiteSpace(current) || current == ClearedMarker) ? new List<string>() : current.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).Where(s => s.Length > 0).ToList();
            var merged = new List<string>(currentItems);
            int added = 0;
            foreach (var item in remoteItems)
            {
                if (!merged.Any(x => x.Equals(item, StringComparison.OrdinalIgnoreCase)))
                {
                    merged.Add(item);
                    added++;
                }
            }

            string mergedStr = merged.Count == 0 ? "" : string.Join("|", merged);
            if (added > 0 || !string.Equals(current.Trim(), mergedStr, StringComparison.Ordinal))
            {
                CPH.SetGlobalVar(globalVarKey, mergedStr, true);
                LogToFile($"[SYNC {logLabel}] ✅ Додано {added} нових записів з GitHub (всього: {merged.Count})");
                CPH.SetGlobalVar($"Hello_filterSync_{logLabel}", $"Додано {added} нових", true);
            }
            else
            {
                LogToFile($"[SYNC {logLabel}] ✓ Без змін");
                CPH.SetGlobalVar($"Hello_filterSync_{logLabel}", "Без змін", true);
            }

            return true;
        }
        catch (Exception ex)
        {
            LogToFile($"[SYNC {logLabel} ERROR] {ex.Message}");
            CPH.LogError($"[HELLO SYNC {logLabel}] {ex.Message}");
            CPH.SetGlobalVar($"Hello_filterSync_{logLabel}", "Помилка", true);
            return false;
        }
    }

