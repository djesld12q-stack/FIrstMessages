    private void OnStreamStarted()
    {
        try
        {
            LogToFile("[STREAM START] ▶ Стрім розпочато — початок очищення");

            streamJustStarted = true;

            lock (queueLock)
            {
                greetQueue.Clear();
                isProcessingQueue = false;
                LogToFile("[STREAM START] ✓ In-memory черга очищена");
            }

            CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
            CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
            Thread.Sleep(200);

            string finalG = CPH.GetGlobalVar<string>("Hello_greetedList",  true) ?? "null";
            string finalP = CPH.GetGlobalVar<string>("Hello_pendingQueue", true) ?? "null";
            bool fgOK = finalG == ClearedMarker;
            bool fpOK = finalP == ClearedMarker;

            LogToFile($"[STREAM START] ✅ Очищено | greetedList={fgOK} | pendingQueue={fpOK}");
            CPH.LogInfo("[HELLO] ✅ Стрім стартував — Hello_greetedList та Hello_pendingQueue очищено");

            if (!fgOK || !fpOK)
            {
                CPH.LogError($"[HELLO] ❌ Верифікація провалилась: g='{finalG}' p='{finalP}'");
                CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
                CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
            }

            Thread.Sleep(300);
            streamJustStarted = false;

            // Перевірка оновлення при старті стріму
            ThreadPool.QueueUserWorkItem(_ => CheckForUpdate());
        }
        catch (Exception ex)
        {
            LogToFile($"[STREAM START ERROR] {ex.Message}");
            CPH.LogError($"[HELLO STREAM START] {ex.Message}");
            try
            {
                CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
                CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
                lock (queueLock) { greetQueue.Clear(); isProcessingQueue = false; }
                streamJustStarted = false;
                LogToFile("[STREAM START] 🆘 Аварійне очищення виконано");
            }
            catch { }
        }
    }

    private void OnStreamStopped()
    {
        try
        {
            LogToFile("[STREAM STOP] ⏹ Стрім завершено — початок очищення");

            streamJustStarted = false;

            lock (queueLock)
            {
                int queueSize = greetQueue.Count;
                greetQueue.Clear();
                isProcessingQueue = false;
                LogToFile($"[STREAM STOP] ✓ In-memory черга очищена (було {queueSize} елементів)");
            }

            CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
            CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
            Thread.Sleep(200);

            string finalG = CPH.GetGlobalVar<string>("Hello_greetedList",  true) ?? "null";
            string finalP = CPH.GetGlobalVar<string>("Hello_pendingQueue", true) ?? "null";
            bool fgOK = finalG == ClearedMarker;
            bool fpOK = finalP == ClearedMarker;

            LogToFile($"[STREAM STOP] ✅ Очищено | greetedList={fgOK} | pendingQueue={fpOK}");
            CPH.LogInfo("[HELLO] ✅ Стрім зупинено — Hello_greetedList та Hello_pendingQueue очищено");

            if (!fgOK || !fpOK)
            {
                CPH.LogError($"[HELLO] ❌ Верифікація при зупинці провалилась: g='{finalG}' p='{finalP}'");
                CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
                CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
            }
        }
        catch (Exception ex)
        {
            LogToFile($"[STREAM STOP ERROR] {ex.Message}");
            CPH.LogError($"[HELLO STREAM STOP] {ex.Message}");
            try
            {
                CPH.SetGlobalVar("Hello_greetedList",  ClearedMarker, true);
                CPH.SetGlobalVar("Hello_pendingQueue", ClearedMarker, true);
                lock (queueLock) { greetQueue.Clear(); isProcessingQueue = false; }
                LogToFile("[STREAM STOP] 🆘 Аварійне очищення виконано");
            }
            catch { }
        }
    }

