    public bool Execute()
    {
        try
        {
            try
            {
                if (args != null)
                {
                    string allArgs = string.Join(" | ", args
                        .Where(kv => kv.Value != null)
                        .Select(kv => $"{kv.Key}={kv.Value}"));
                    if (allArgs.Length > 0)
                        LogToFile($"[ARGS] {allArgs}");
                }
            }
            catch { }

            if (IsStreamStartEvent())
            {
                LogToFile("[EXECUTE] → Detected STREAM START event");
                OnStreamStarted();
                return true;
            }

            if (IsStreamStopEvent())
            {
                LogToFile("[EXECUTE] → Detected STREAM STOP event");
                OnStreamStopped();
                return true;
            }

            // Ручний виклик перевірки оновлення (наприклад, окремою командою/дією з triggerId)
            string updateTriggerId = GetArg("triggerId");
            if (updateTriggerId == "UPDATE-CHECK-TRIGGER-ID")
            {
                ThreadPool.QueueUserWorkItem(_ => CheckForUpdate(announceInChat: true));
                return true;
            }

            string user = GetArg("user")
                ?? GetArg("userName")
                ?? GetArg("displayName")
                ?? GetArg("redeemer")
                ?? GetArg("targetUser")
                ?? GetArg("raidUser")
                ?? GetArg("from_broadcaster_user_name")
                ?? "друже";

            if (string.IsNullOrWhiteSpace(user)) { LogToFile("[SKIP] Порожнє ім'я"); return true; }
            user = user.Trim();
            string key    = user.ToLowerInvariant();
            string source = GetArg("__source") ?? "невідомо";

            LogToFile($"[EXECUTE START] {user} | greetedList: '{CPH.GetGlobalVar<string>("Hello_greetedList", true) ?? "null"}'");

            if (streamJustStarted)
            {
                ClearHelloLists("Execute - streamJustStarted");
                lock (queueLock) { greetQueue.Clear(); isProcessingQueue = false; }
                streamJustStarted = false;
                LogToFile($"[SKIP] {user} | streamJustStarted");
                return true;
            }

            string triggerId = GetArg("triggerId");
            if (triggerId == "729c7c0a-597f-4291-97db-bf756847f819")
            {
                OpenSettingsWindow();
                ThreadPool.QueueUserWorkItem(_ =>
                {
                    ClearHelloLists("GUI Trigger");
                    LogToFile("[GUI] Відкрито налаштування");
                });
                return true;
            }

            string userId   = GetArg("userId")   ?? GetArg("user_id")          ?? "";
            string bcUserId = GetArg("broadcaster_user_id") ?? GetArg("broadcasterUserId") ?? "";
            string bcLogin  = GetArg("broadcaster_user_login") ?? GetArg("broadcasterUserLogin") ?? "";

            if (!string.IsNullOrWhiteSpace(userId) && !string.IsNullOrWhiteSpace(bcUserId)
                && userId.Equals(bcUserId, StringComparison.OrdinalIgnoreCase))
            { LogToFile($"[SKIP] {user} | Broadcaster (userId)"); return true; }

            if (!string.IsNullOrWhiteSpace(bcLogin)
                && key.Equals(bcLogin.Trim().ToLowerInvariant()))
            { LogToFile($"[SKIP] {user} | Broadcaster (login)"); return true; }

            if (IsFullyExcluded(key)) { LogToFile($"[SKIP] {user} | excludedUsers"); return true; }

            bool isReward = !string.IsNullOrEmpty(GetArg("rewardId"))
                || source.IndexOf("reward",      StringComparison.OrdinalIgnoreCase) >= 0
                || source.IndexOf("redemption",  StringComparison.OrdinalIgnoreCase) >= 0;

            string firstRaw = (GetArg("firstMessage")
                ?? GetArg("isFirstMessage")
                ?? GetArg("first_message")
                ?? "false").Trim().ToLowerInvariant();

            bool isFirstMessage = firstRaw == "true" || firstRaw == "1"
                || source.IndexOf("first", StringComparison.OrdinalIgnoreCase) >= 0
                || source.IndexOf("words", StringComparison.OrdinalIgnoreCase) >= 0;

            bool isRaid     = !string.IsNullOrEmpty(GetArg("viewers"))
                || source.IndexOf("raid", StringComparison.OrdinalIgnoreCase) >= 0;

            bool isTestMode = (GetArg("__test") ?? "").Equals("true", StringComparison.OrdinalIgnoreCase);

            var greeted = GetGreetedSet();
            if (greeted.Contains(key)) { LogToFile($"[SKIP] {user} | Вже привітаний"); return true; }

            string message = (GetArg("message")
                ?? GetArg("input")
                ?? GetArg("rawInput")
                ?? GetArg("rewardInput")
                ?? "").Trim();

            LogToFile($"[MESSAGE] {user} | message='{message}' | isReward={isReward} | isFirstMessage={isFirstMessage} | isRaid={isRaid}");

            if (message.Length > 0)
            {
                if (ContainsIgnoreWord(message))    { LogToFile($"[SKIP] {user} | Ігнор-слово");       return true; }
                if (ContainsIgnoreSymbol(message))  { LogToFile($"[SKIP] {user} | Ігнор-символ");      return true; }
                if (ContainsRussianLetter(message)) { LogToFile($"[SKIP] {user} | Кирилиця");          return true; }
                if (ContainsBadDomain(message))     { LogToFile($"[SKIP] {user} | Заборонений домен"); return true; }
            }

            bool shouldGreet = isReward || isFirstMessage || isRaid || isTestMode;
            if (!shouldGreet) { LogToFile($"[SKIP] {user} | Не підходить під тип"); return true; }

            LogToFile($"[GREET] {user} | {(isReward ? "Нагорода" : isFirstMessage ? "Перше повідомлення" : isRaid ? "Рейд" : "Тест")}");

            greeted.Add(key);
            SaveGreetedSet(greeted);

            string viewers       = isRaid ? (GetArg("viewers") ?? "багатьох") : null;
            bool   onlyMediaMode = IsOnlyMedia(key);
            bool   noSoundMode   = !onlyMediaMode && IsIgnoredMedia(key);
            bool   sendText      = !onlyMediaMode;
            string greetingText  = sendText ? GetGreetingText(user, viewers, isRaid) : null;
            bool   playSound     = onlyMediaMode || !noSoundMode;

            string userSoundPath = GetUserSound(key);
            LogToFile($"[USER SOUND] {user} | path='{userSoundPath ?? "default"}'");

            string profileImageUrl = GetArg("targetUserProfileImageUrl")
                ?? GetArg("userProfileImageUrl")
                ?? GetArg("profileImageUrl")
                ?? GetArg("profile_image_url");

            LogToFile($"[PROFILE URL] {user} | url='{profileImageUrl ?? "null"}'");

            if (sendText && !string.IsNullOrEmpty(greetingText))
            {
                try { CPH.SendMessage(greetingText, true); LogToFile($"[TEXT] {user} | Відправлено"); }
                catch (Exception ex) { LogToFile($"[TEXT ERROR] {user} | {ex.Message}"); }
            }

            string capturedUser       = user;
            bool   capturedPlaySound  = playSound;
            string capturedProfileUrl = profileImageUrl;
            string capturedKey        = key;
            string capturedSoundPath  = userSoundPath;

            Action mediaAction = () =>
            {
                try
                {
                    PlayMedia(capturedUser, capturedPlaySound, capturedProfileUrl, capturedSoundPath);
                    LogToFile($"[MEDIA] {capturedUser} | Відтворено");
                }
                catch (Exception ex) { LogToFile($"[MEDIA ERROR] {capturedUser} | {ex.Message}"); }

                int delaySec = GetIntSetting("queueDelaySec");
                if (delaySec > 0) CPH.Wait(delaySec * 1000);

                lock (queueLock)
                {
                    var pending = GetPendingQueue();
                    pending.RemoveAll(p => p.Equals(capturedKey, StringComparison.OrdinalIgnoreCase));
                    SavePendingQueue(pending);
                }
            };

            lock (queueLock)
            {
                var pending = GetPendingQueue();
                if (!pending.Any(p => p.Equals(key, StringComparison.OrdinalIgnoreCase)))
                {
                    bool hasPriority = isReward || isFirstMessage || isRaid;
                    if (hasPriority)
                    {
                        pending.Insert(0, key);
                        var existing = greetQueue.ToArray();
                        greetQueue.Clear();
                        greetQueue.Enqueue(mediaAction);
                        foreach (var a in existing) greetQueue.Enqueue(a);
                        LogToFile($"[QUEUE] {user} | ПРІОРИТЕТ");
                    }
                    else
                    {
                        pending.Add(key);
                        greetQueue.Enqueue(mediaAction);
                        LogToFile($"[QUEUE] {user} | Додано");
                    }
                    SavePendingQueue(pending);
                }
            }

            bool shouldStart = false;
            lock (queueLock)
            {
                if (!isProcessingQueue)
                {
                    isProcessingQueue = true;
                    shouldStart = true;
                }
            }
            if (shouldStart)
                ThreadPool.QueueUserWorkItem(_ => ProcessQueue());

            return true;
        }
        catch (Exception ex)
        {
            LogToFile($"[EXECUTE ERROR] {GetArg("user") ?? "?"} | {ex.Message}");
            CPH.LogError($"[HELLO ERROR] {ex.Message}");
            return false;
        }
    }

