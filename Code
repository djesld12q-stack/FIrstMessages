    // ⚠️ Онови цю константу на поточну версію скрипта при кожному релізі,
    // і постав таке саме значення у файл Version в репозиторії, коли випускаєш новий реліз.
    private const string CurrentVersion = "1.0.1";

    private string HttpGetString(string url)
    {
        try
        {
            ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
            using (var client = new WebClient())
            {
                client.Headers.Add("User-Agent", "StreamerBot-Hello-Updater");
                client.Encoding = Encoding.UTF8;
                // Анти-кеш, щоб raw.githubusercontent.com не віддавав старий кеш
                string sep = url.Contains("?") ? "&" : "?";
                string bustedUrl = url + sep + "cachebust=" + DateTime.UtcNow.Ticks;
                return client.DownloadString(bustedUrl);
            }
        }
        catch (Exception ex)
        {
            LogToFile($"[UPDATE HTTP ERROR] {url} | {ex.Message}");
            return null;
        }
    }

    /// <summary>
    /// Перевіряє версію в репозиторії й порівнює з поточною версією скрипта.
    /// Якщо є новіша — пише повідомлення в чат (якщо announceInChat = true) і в лог,
    /// та зберігає прапорці/значення у глобальні змінні для GUI.
    /// </summary>
    private bool CheckForUpdate(bool announceInChat = false)
    {
        try
        {
            LogToFile("[UPDATE] 🔍 Перевірка оновлень...");
            string remoteRaw = HttpGetString(UpdateVersionUrl);
            if (string.IsNullOrWhiteSpace(remoteRaw))
            {
                LogToFile("[UPDATE] ❌ Не вдалось отримати Version з репозиторію");
                CPH.SetGlobalVar("Hello_updateStatus", "Помилка перевірки", true);
                return false;
            }

            string remoteVersion = remoteRaw.Trim();
            CPH.SetGlobalVar("Hello_remoteVersion",  remoteVersion, true);
            CPH.SetGlobalVar("Hello_lastCheckTime",  DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture), true);

            bool isNewer = IsVersionNewer(remoteVersion, CurrentVersion);
            CPH.SetGlobalVar("Hello_updateAvailable", isNewer ? "true" : "false", true);

            if (isNewer)
            {
                string msg = $"⚡ Доступне оновлення скрипта Hello: {CurrentVersion} → {remoteVersion}. Онови код через Streamer.bot (Import Code) або кнопку «Завантажити оновлення» у вкладці «Про мене».";
                LogToFile($"[UPDATE] 🔔 Знайдено нову версію: {remoteVersion} (поточна: {CurrentVersion})");
                CPH.SetGlobalVar("Hello_updateStatus", $"Доступна нова версія: {remoteVersion}", true);
                CPH.LogWarn($"[HELLO UPDATE] Доступна нова версія {remoteVersion} (поточна {CurrentVersion})");

                if (announceInChat)
                {
                    try { CPH.SendMessage(msg, true); }
                    catch (Exception ex) { LogToFile($"[UPDATE CHAT ERROR] {ex.Message}"); }
                }
            }
            else
            {
                LogToFile($"[UPDATE] ✅ Версія актуальна ({CurrentVersion})");
                CPH.SetGlobalVar("Hello_updateStatus", "Версія актуальна", true);
            }

            return isNewer;
        }
        catch (Exception ex)
        {
            LogToFile($"[UPDATE ERROR] {ex.Message}");
            CPH.LogError($"[HELLO UPDATE] {ex.Message}");
            CPH.SetGlobalVar("Hello_updateStatus", "Помилка перевірки", true);
            return false;
        }
    }

    /// <summary>
    /// Порівнює дві версії у форматі "1.2.3". Повертає true, якщо remote новіша за local.
    /// Якщо формат не парситься як версія — порівнює як прості рядки (remote != local).
    /// </summary>
    private bool IsVersionNewer(string remote, string local)
    {
        try
        {
            Version rv, lv;
            string remoteNorm = NormalizeVersionString(remote);
            string localNorm  = NormalizeVersionString(local);

            if (Version.TryParse(remoteNorm, out rv) && Version.TryParse(localNorm, out lv))
                return rv > lv;
        }
        catch { }

        // fallback: прості рядки не рівні => вважаємо що є "оновлення"
        return !string.Equals(remote?.Trim(), local?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private string NormalizeVersionString(string v)
    {
        if (string.IsNullOrWhiteSpace(v)) return "0.0.0";
        v = v.Trim().TrimStart('v', 'V');
        // Version.Parse не любить одиночні числа типу "5" — доповнюємо до "5.0"
        int dots = v.Count(c => c == '.');
        if (dots == 0) v += ".0";
        return v;
    }

    /// <summary>
    /// Завантажує актуальний код (файл Code) з репозиторію, зберігає локально
    /// у файл UpdateDownloadPath і копіює його в буфер обміну, щоб користувачу
    /// залишилось лише відкрити дію Streamer.bot і натиснути Ctrl+V → Compile → Save.
    /// Повністю автоматичне (без жодної ручної дії) оновлення коду дії Streamer.bot
    /// зсередини самого скрипта неможливе: Streamer.bot не надає публічного CPH-методу
    /// для перезапису C#-коду сабекшена, а скомпільований код живе в пам'яті процесу —
    /// тому фінальний крок (вставити + Compile + Save) користувач має виконати сам.
    /// </summary>
    private bool DownloadLatestCode(out string savedPath)
    {
        savedPath = null;
        try
        {
            LogToFile("[UPDATE] ⬇ Завантаження актуального коду...");
            string code = HttpGetString(UpdateCodeUrl);
            if (string.IsNullOrWhiteSpace(code))
            {
                LogToFile("[UPDATE] ❌ Не вдалось завантажити Code з репозиторію");
                CPH.SetGlobalVar("Hello_updateStatus", "Помилка завантаження коду", true);
                return false;
            }

            string dir = Path.GetDirectoryName(UpdateDownloadPath);
            if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
                Directory.CreateDirectory(dir);

            File.WriteAllText(UpdateDownloadPath, code, Encoding.UTF8);
            savedPath = UpdateDownloadPath;

            bool clipboardOk = CopyToClipboardSafe(code);

            LogToFile($"[UPDATE] ✅ Код збережено: {UpdateDownloadPath} | Буфер обміну: {(clipboardOk ? "OK" : "помилка")}");
            CPH.LogInfo($"[HELLO UPDATE] Новий код збережено у {UpdateDownloadPath}{(clipboardOk ? " і скопійовано в буфер обміну" : "")}. Встав його в дію Streamer.bot (Ctrl+V) → Compile → Save.");
            CPH.SetGlobalVar("Hello_updateStatus", clipboardOk
                ? "Код скопійовано в буфер обміну — встав (Ctrl+V) у дію та натисни Compile → Save"
                : "Код завантажено (буфер обміну недоступний) — відкрий файл і встав вручну",
                true);
            return true;
        }
        catch (Exception ex)
        {
            LogToFile($"[UPDATE DOWNLOAD ERROR] {ex.Message}");
            CPH.LogError($"[HELLO UPDATE] {ex.Message}");
            CPH.SetGlobalVar("Hello_updateStatus", "Помилка завантаження коду", true);
            return false;
        }
    }

    /// <summary>
    /// Копіює текст у системний буфер обміну. Windows Clipboard API вимагає STA-потік,
    /// тому створюємо окремий короткоживучий STA-потік лише для цієї операції.
    /// Повертає true, якщо копіювання підтверджено успішним.
    /// </summary>
    private bool CopyToClipboardSafe(string text)
    {
        bool success = false;
        try
        {
            var t = new Thread(() =>
            {
                for (int attempt = 0; attempt < 3 && !success; attempt++)
                {
                    try
                    {
                        Clipboard.SetText(text);
                        success = true;
                    }
                    catch (Exception ex)
                    {
                        LogToFile($"[CLIPBOARD ATTEMPT {attempt + 1}] {ex.Message}");
                        Thread.Sleep(120);
                    }
                }
            });
            t.SetApartmentState(ApartmentState.STA);
            t.IsBackground = true;
            t.Start();
            t.Join(3000);
        }
        catch (Exception ex)
        {
            LogToFile($"[CLIPBOARD ERROR] {ex.Message}");
        }
        return success;
    }

