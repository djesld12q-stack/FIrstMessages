            CPH.LogWarn($"[HELLO GUI] Помилка збереження: {ex.Message}");
            LogToFile($"[GUI ERROR] {ex.Message}");
        }
    }

    private UIElement MakeAutoRefreshField(string tag, int height = 44, bool multiline = true)
    {
        string val = "";
        try
        {
            val = CPH.GetGlobalVar<string>(tag, true) ?? "";
        }
        catch
        {
        }

        var tb = new TextBox
        {
            Tag = tag,
            Text = val,
            MinHeight = height,
            Padding = new Thickness(12, 9, 12, 9),
            Background = Brushes.Transparent,
            Foreground = new SolidColorBrush(TextPrimary),
            CaretBrush = new SolidColorBrush(AccentBlue),
            BorderThickness = new Thickness(0),
            FontSize = 13,
            FontFamily = new FontFamily("Consolas"),
            TextWrapping = multiline ? TextWrapping.Wrap : TextWrapping.NoWrap,
            AcceptsReturn = multiline,
            VerticalScrollBarVisibility = multiline ? ScrollBarVisibility.Auto : ScrollBarVisibility.Disabled,
            HorizontalScrollBarVisibility = ScrollBarVisibility.Disabled,
            HorizontalAlignment = HorizontalAlignment.Stretch,
            VerticalContentAlignment = VerticalAlignment.Top
        };
        var border = new Border
        {
            Child = tb,
            CornerRadius = new CornerRadius(8),
            Background = new SolidColorBrush(BgInput),
            BorderBrush = new SolidColorBrush(BorderNormal),
            BorderThickness = new Thickness(2),
            Margin = new Thickness(0, 0, 0, 16),
            HorizontalAlignment = HorizontalAlignment.Stretch
        };
        bool isFocused = false;
        tb.GotFocus += (s, e) =>
        {
            isFocused = true;
            border.BorderBrush = new SolidColorBrush(BorderFocus);
        };
        tb.LostFocus += (s, e) =>
        {
            isFocused = false;
            border.BorderBrush = new SolidColorBrush(BorderNormal);
            try
            {
                if (tb.Tag is string t && !string.IsNullOrEmpty(t))
                    CPH.SetGlobalVar(t, tb.Text?.Trim() ?? "", true);
            }
            catch (Exception ex)
            {
                CPH.LogWarn($"[HELLO GUI] LostFocus save error ({tb.Tag}): {ex.Message}");
            }
        };
        var refreshTimer = new DispatcherTimer
        {
            Interval = TimeSpan.FromSeconds(5)
        };
        refreshTimer.Tick += (s, e) =>
        {
            if (isFocused)
                return;
            try
            {
                string latest = CPH.GetGlobalVar<string>(tag, true) ?? "";
                if (latest != tb.Text)
                {
                    int caret = tb.CaretIndex;
                    tb.Text = latest;
                    tb.CaretIndex = Math.Min(caret, tb.Text.Length);
                }
            }
            catch
            {
            }
        };
        tb.Unloaded += (s, e) => refreshTimer.Stop();
        refreshTimer.Start();
        return border;
    }

    private void AddAutoRefreshLF(StackPanel p, string label, string tag, bool multiline = true, int height = 80, string hint = "")
    {
        AddFieldLabel(p, label.ToUpperInvariant());
        p.Children.Add(MakeAutoRefreshField(tag, height, multiline));
        if (!string.IsNullOrEmpty(hint))
            AddHintBox(p, hint);
    }

    private static readonly HashSet<string> GitHubManagedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Hello_ignoreWords",
        "Hello_ignoreSymbols",
        "Hello_russianLetters",
        "Hello_excludedBots"
    };
    private void SaveTextBoxesInGrid(DependencyObject parent)
    {
        if (parent == null)
            return;
        int n = VisualTreeHelper.GetChildrenCount(parent);
        for (int i = 0; i < n; i++)
        {
            var child = VisualTreeHelper.GetChild(parent, i);
            if (child is TextBox tb && tb.Tag is string tag && !string.IsNullOrEmpty(tag))
            {
                if (GitHubManagedTags.Contains(tag))
                    continue;
                string val = tb.Text?.Trim() ?? "";
                if (val == tag)
                    val = "";
                CPH.SetGlobalVar(tag, val, true);
            }
            else
            {
                SaveTextBoxesInGrid(child);
            }
        }
    }
