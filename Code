    private string HttpGetString(string url)
    {
        try
        {
            ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
            using (var client = new WebClient())
            {
                client.Headers.Add("User-Agent", "StreamerBot-Hello-Updater");
                client.Encoding = Encoding.UTF8;
                string sep = url.Contains("?") ? "&" : "?";
                string bustedUrl = url + sep + "cachebust=" + DateTime.UtcNow.Ticks;
                var task = client.DownloadStringTaskAsync(bustedUrl);
                if (!task.Wait(TimeSpan.FromSeconds(5)))
                {
                    client.CancelAsync();
                    LogToFile($"[UPDATE HTTP TIMEOUT] {url}");
                    return null;
                }

                return task.Result;
            }
        }
        catch (Exception ex)
        {
            LogToFile($"[UPDATE HTTP ERROR] {url} | {ex.Message}");
            return null;
        }
    }

