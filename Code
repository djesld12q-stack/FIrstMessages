    private bool IsBroadcaster(string key)
    {
        if (string.IsNullOrEmpty(key))
            return false;

        try
        {
            string broadcasterName = (CPH.TwitchGetBroadcaster()?.UserName ?? "").Trim().ToLowerInvariant();
            if (!string.IsNullOrEmpty(broadcasterName) && broadcasterName == key)
                return true;
        }
        catch
        {
        }

        string[] loginKeys =
        {
            "broadcaster_user_login",
            "broadcasterUserLogin",
            "broadcasterName",
            "broadcaster",
            "channel"
        };
        foreach (var k in loginKeys)
        {
            string v = (GetArg(k) ?? "").Trim().ToLowerInvariant();
            if (!string.IsNullOrEmpty(v) && v == key)
                return true;
        }

        string[] idKeys =
        {
            "broadcaster_user_id",
            "broadcasterUserId",
            "broadcasterId"
        };
        string[] userIdKeys =
        {
            "userId",
            "user_id",
            "targetUserId"
        };
        foreach (var idk in idKeys)
        {
            string bId = (GetArg(idk) ?? "").Trim();
            if (string.IsNullOrEmpty(bId))
                continue;
            foreach (var uidk in userIdKeys)
            {
                string uId = (GetArg(uidk) ?? "").Trim();
                if (!string.IsNullOrEmpty(uId) && uId == bId)
                    return true;
            }
        }

        return false;
    }

    private bool IsStreamStartEvent()
    {
        string[] keys =
        {
            "eventType",
            "__source",
            "triggerName",
            "eventSource",
            "__trigger",
            "type"
        };
        foreach (var k in keys)
        {
            string v = (GetArg(k) ?? "").ToLowerInvariant();
            if (string.IsNullOrEmpty(v))
                continue;
            bool hasStream = v.Contains("stream") || v.Contains("obs");
            bool hasStart = v.Contains("start") || v.Contains("began") || v.Contains("begin") || v.Contains("launch");
            if (hasStream && hasStart)
