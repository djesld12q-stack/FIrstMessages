    private bool TryCopyToClipboard(string text)
    {
        for (int attempt = 0; attempt < 6; attempt++)
        {
            try
            {
                Clipboard.SetText(text, TextDataFormat.UnicodeText);
                return true;
            }
            catch (Exception ex)
            {
                LogToFile($"[CLIPBOARD] Спроба {attempt + 1}/6 не вдалась: {ex.Message}");
                Thread.Sleep(120);
            }
        }

        return false;
    }

    private bool SyncRemoteList(string url, string globalVarKey, string logLabel, bool force = false)
