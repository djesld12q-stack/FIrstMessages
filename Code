    private void ForceRefreshAllAutoFields(DependencyObject parent)
    {
        if (parent == null)
            return;
        int n = VisualTreeHelper.GetChildrenCount(parent);
        for (int i = 0; i < n; i++)
        {
            var child = VisualTreeHelper.GetChild(parent, i);
            if (child is TextBox tb && tb.Tag is string tag && !string.IsNullOrEmpty(tag) && GitHubManagedTags.Contains(tag))
            {
                try
                {
                    if (!tb.IsFocused)
                    {
                        string latest = CPH.GetGlobalVar<string>(tag, true) ?? "";
                        if (latest != tb.Text)
                            tb.Text = latest;
                    }
                }
                catch (Exception ex)
                {
                    CPH.LogWarn($"[HELLO GUI] ForceRefresh error ({tag}): {ex.Message}");
                }
            }

            ForceRefreshAllAutoFields(child);
        }
    }


